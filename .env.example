# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://aaradonc.com

# ─── Google Tag Manager ───────────────────────────────────────────────────────
# Replace GTM-XXXXXXX with the real container ID before go-live.
# GA4 is installed via GTM only — do NOT install GA4 directly.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ─── Contact info (shown in header topbar and footer) ─────────────────────────
NEXT_PUBLIC_PHONE=(561) 000-0000
NEXT_PUBLIC_EMAIL=info@aaradonc.com
NEXT_PUBLIC_ADDRESS_STREET=
NEXT_PUBLIC_ADDRESS_CITY=Royal Palm Beach
NEXT_PUBLIC_ADDRESS_ZIP=

# ─── Geo coordinates (for LocalBusiness schema) ───────────────────────────────
NEXT_PUBLIC_GEO_LAT=
NEXT_PUBLIC_GEO_LNG=

# ─── Business hours (for LocalBusiness schema) ────────────────────────────────
NEXT_PUBLIC_HOURS=Mo-Fr 08:00-17:00

# ─── Forms — Web3Forms ────────────────────────────────────────────────────────
# Static-export compatible form service (free tier available at web3forms.com).
# Get your access key at: https://web3forms.com/
# Alternative: Formspree (https://formspree.io) or Getform (https://getform.io).
NEXT_PUBLIC_WEB3FORMS_KEY=your_access_key_here
